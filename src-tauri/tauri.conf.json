{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Attend NFC Bridge",
  "version": "2.0.0",
  "identifier": "com.hackclub.attend-nfc-bridge",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Attend NFC Bridge",
        "width": 460,
        "height": 360,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Bridges USB NFC readers to web browsers",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["pcscd", "libpcsclite1"]
      }
    }
  }
}
